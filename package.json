{
  "name": "gym-progress",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@gym/web run dev",
    "build": "npm --workspace=@gym/web run build",
    "test": "npm run test --workspaces --if-present",
    "import-exercises": "node scripts/import-exercises/import.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
